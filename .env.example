# .env.example — Drakkar
#
# PLANTILLA. Este archivo SÍ va a Git; el .env real NO (ver .gitignore y D-009).
#
# Para montar un servidor nuevo:
#   1. Copiar este archivo como .env
#   2. Rellenar cada valor
#   3. No commitearlo nunca
#
# Todas las variables sin valor por defecto son obligatorias: si falta una,
# el proyecto falla al arrancar con un mensaje claro. Es intencional — un
# servidor a medio configurar no debe arrancar "más o menos" (D-009).


# ===========================================================================
# DJANGO
# ===========================================================================

# Clave con la que Django firma sesiones, cookies y tokens CSRF.
# CADA ENTORNO TIENE LA SUYA. Filtrar una no compromete a las demás.
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Dominios desde los que se puede servir la aplicación, separados por coma.
# SOLO PRODUCCIÓN — dev.py usa localhost y no lee esta variable.
# Ejemplo: app.drakkar.cl,demo.drakkar.cl
DJANGO_ALLOWED_HOSTS=


# ===========================================================================
# BASE DE DATOS (PostgreSQL)
# ===========================================================================

# Una base por entorno, nunca compartidas (D-010):
#   drakkar_dev   → tu máquina
#   drakkar_demo  → el demo en la Pi
#   drakkar_prod  → el cliente real
DB_NAME=

DB_USER=

# Contraseña propia de cada entorno. No reutilizar entre servidores.
DB_PASSWORD=

# Opcionales: si no se declaran, se usan estos valores.
DB_HOST=localhost
DB_PORT=5432


# ===========================================================================
# CÓMO SE ELIGE EL ENTORNO
# ===========================================================================
#
# El entorno NO se elige acá: se elige con DJANGO_SETTINGS_MODULE, una
# variable del sistema operativo (D-008).
#
#   Desarrollo → config.settings.dev   (es el valor por defecto de manage.py)
#   Producción → config.settings.prod  (lo impone el servicio de systemd)
#
# Que esté fuera del .env es a propósito: producción no puede cargar
# configuración de desarrollo por accidente.
